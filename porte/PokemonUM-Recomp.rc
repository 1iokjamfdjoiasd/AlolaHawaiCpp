// Icon + version information of the Ultra Moon recompiled test (UTF-16 strings)
#include <winver.h>
1 ICON "PokemonUM.ico"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName", "Projeto pessoal (porte de teste)"
            VALUE "FileDescription", "Pokemon Ultra Moon PC - teste de recompilacao (Azahar + codigo nativo)"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "PokemonUltraMoon-Recomp"
            VALUE "LegalCopyright", "GPLv2 ou posterior (Azahar / Citra)"
            VALUE "OriginalFilename", "PokemonUltraMoon-Recomp.exe"
            VALUE "ProductName", "Pokemon Ultra Moon PC (teste)"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
