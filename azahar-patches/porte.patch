+// (porte) rewind: the serialized state only (the expensive compression is done elsewhere, see PorteFinishState).
+// Written straight into a vector reserved with the last size (an ostringstream grew by copying, then the whole string
+// was copied again: ~380 ms for ~300 MB)
+namespace {
+struct PorteVecBuf : std::streambuf {
+    std::vector<u8>& v;
+    explicit PorteVecBuf(std::vector<u8>& out) : v(out) {}
+    std::streamsize xsputn(const char* s, std::streamsize n) override {
+        v.insert(v.end(), reinterpret_cast<const u8*>(s), reinterpret_cast<const u8*>(s) + n);
+        return n;
+    }
+    int_type overflow(int_type c) override {
+        if (c != traits_type::eof()) {
+            v.push_back(static_cast<u8>(c));
+        }
+        return c;
+    }
+};
+} // namespace
+
+std::vector<u8> System::PorteRawState() const {
+    static std::size_t last_size = 0;
+    std::vector<u8> out = std::move(porte_rewind_spare);   // (the frontend hands back the buffer of an older point)
+    porte_rewind_spare = {};
+    out.clear();
+    const std::size_t want = last_size ? last_size + last_size / 16 : (std::size_t{320} << 20);
+    if (out.capacity() < want) {
+        out.reserve(want);
+    }
+    {
+        PorteVecBuf buf{out};
+        std::ostream os{&buf};
+        oarchive oa{os};
+        oa&* this;
+    }
+    last_size = out.size();
+    return out;
+}
+
+// (porte) rewind: the same layout as SaveStateBuffer (header + zstd data), from a raw state; safe on another thread
+std::vector<u8> System::PorteFinishState(std::span<const u8> raw, int level) const {
+    auto buffer = Common::Compression::CompressDataZSTD(raw, level);
+    CSTHeader header{};
+    header.filetype = header_magic_bytes;
+    header.program_id = title_id;
+    std::string rev_bytes;
+    CryptoPP::StringSource ss(Common::g_scm_rev, true,
+                              new CryptoPP::HexDecoder(new CryptoPP::StringSink(rev_bytes)));
+    std::memcpy(header.revision.data(), rev_bytes.data(), sizeof(header.revision));
+    header.time = std::chrono::duration_cast<std::chrono::seconds>(
+                      std::chrono::system_clock::now().time_since_epoch())
+                      .count();
+    std::vector<u8> result((u8*)&header, (u8*)&header + sizeof(header));
+    result.insert(result.end(), buffer.begin(), buffer.end());
+    return result;
+}
