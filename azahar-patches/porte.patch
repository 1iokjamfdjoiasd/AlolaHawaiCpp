+// ---------------------------------------------------------------- PORTE: gravar e repetir (porte_repeat.h)
+void RasterizerVulkan::PorteCaptureBegin() {
+    porte_cap = std::make_shared<PorteCapture>();
+    porte_cap_valid = false;
+    // the recording must not depend on anything set before it: close the render pass and make everything
+    // (pipeline, descriptor sets, all uniforms) be set again by its first draw
+    renderpass_cache.EndRendering();
+    vs_data_dirty = true;
+    fs_data_dirty = true;
+    pica.vs_setup.uniforms_dirty = true;
+    scheduler.MakeDirty(StateFlags::Pipeline | StateFlags::DescriptorSets);
+    StreamBuffer* const rings[4] = {&stream_buffer, &uniform_buffer, &texture_buffer, &texture_lf_buffer};
+    for (std::size_t i = 0; i < 4; i++) {
+        porte_lo[i] = rings[i]->PorteOffset();
+        porte_wraps[i] = rings[i]->PorteWraps();
+    }
+    porte_cap_gen = (Common::g_porte_slot_gen - Common::g_porte_fill_erases);
+    porte_cap_tick = scheduler.CurrentTick();
+    Common::g_porte_cap_since = porte_cap_tick;   // (a surface recycled from before this cannot be in the recording)
+    g_porte_capturing = porte_cap.get();
+}
+
+bool RasterizerVulkan::PorteCaptureEnd() {
+    renderpass_cache.EndRendering(); // (recorded: the recording ends with the render pass closed)
+    g_porte_capturing = nullptr;
+    bool ok = porte_cap && !porte_cap->bad && !porte_cap->cmds.empty();
+    StreamBuffer* const rings[4] = {&stream_buffer, &uniform_buffer, &texture_buffer, &texture_lf_buffer};
+    for (std::size_t i = 0; i < 4; i++) {
+        // went back to the start while recording: the recorded regions are not one block
+        if (rings[i]->PorteWraps() != porte_wraps[i]) {
+            ok = false;
+        }
+        porte_hi[i] = rings[i]->PorteOffset();
+    }
+    // a slot emptied or replaced while recording (surfaces only SENTENCED are fine: they are pinned below)
+    if ((Common::g_porte_slot_gen - Common::g_porte_fill_erases) != porte_cap_gen) {
+        ok = false;
+    }
+    porte_cap_recycle = Common::g_porte_recycle_gen;
+    porte_cap_valid = ok;
+    static int porte_diag = std::getenv("PORTE_INTERP_DIAG") ? 30 : 0;
+    if (!ok && porte_diag > 0) {
+        porte_diag--;
+        std::fprintf(stderr, "repetir: gravação recusada: bad=%d cmds=%zu voltas=%d%d%d%d gen %llu->%llu binds=%zu sets=%zu\n",
+                     porte_cap ? (int)porte_cap->bad : -1, porte_cap ? porte_cap->cmds.size() : 0,
+                     (int)(rings[0]->PorteWraps() != porte_wraps[0]), (int)(rings[1]->PorteWraps() != porte_wraps[1]),
+                     (int)(rings[2]->PorteWraps() != porte_wraps[2]), (int)(rings[3]->PorteWraps() != porte_wraps[3]),
+                     (unsigned long long)porte_cap_gen, (unsigned long long)(Common::g_porte_slot_gen - Common::g_porte_fill_erases),
+                     porte_cap ? porte_cap->slot_draw.size() : 0, porte_cap ? porte_cap->sets.size() : 0);
+    }
+    return ok;
+}
+
+bool RasterizerVulkan::PorteRepeat(const Pica::Uniforms* const* per_draw, std::size_t count) {
+    // a slot emptied/replaced since the recording began, or a surface recycled since it ended: the recorded
+    // commands may name it - no more repeats
+    if (!porte_cap_valid || (Common::g_porte_slot_gen - Common::g_porte_fill_erases) != porte_cap_gen ||
+        Common::g_porte_recycle_gen != porte_cap_recycle) {
+        porte_cap_valid = false;
+        return false;
+    }
+    renderpass_cache.EndRendering();
+    const auto cap = porte_cap;
+    const std::size_t n = cap->slot_draw.size();
+    auto table = std::make_shared<std::vector<u32>>(cap->slot_offset0);
+    if (n > 0) {
+        const u32 bytes = static_cast<u32>(n) * uniform_size_aligned_vs_pica;
+        if (bytes > UNIFORM_BUFFER_SIZE / 4) {
+            porte_cap_valid = false;
+            return false;
+        }
+        auto [ptr, offset, invalidate] = uniform_buffer.Map(bytes, uniform_buffer_alignment);
+        u32 used = 0;
+        for (std::size_t s = 0; s < n; s++) {
+            const int d = cap->slot_draw[s];
+            if (d < 0 || static_cast<std::size_t>(d) >= count || !per_draw[d]) {
+                continue; // keeps its recorded uniforms
+            }
+            const Pica::Uniforms& u = *per_draw[d];
+            Pica::Shader::Generator::VSPicaUniformData data;
+            data.b = 0;
+            for (u32 j = 0; j < u.b.size(); j++) {
+                data.b |= u.b[j] << j;
+            }
+            for (u32 j = 0; j < u.i.size(); j++) {
+                data.i[j] = Common::MakeVec<u32>(u.i[j].x, u.i[j].y, u.i[j].z, u.i[j].w);
+            }
+            for (u32 j = 0; j < u.f.size(); j++) {
+                data.f[j] = Common::MakeVec<f32>(u.f[j].x.ToFloat32(), u.f[j].y.ToFloat32(),
+                                                 u.f[j].z.ToFloat32(), u.f[j].w.ToFloat32());
+            }
+            // (porte) 16:9: the same widening as UploadUniforms (the repeated pictures went out without it: the
+            // picture "fought" between wide and not, the interpolated pictures alternating with the real ones)
+            if (VideoCore::g_porte_wide_proj != 1.0f && s < cap->slot_top.size() && cap->slot_top[s]) {
+                auto& f = data.f;
+                if (f[89][0] == 0.0f && f[89][1] == 0.0f && f[89][2] == -1.0f && f[89][3] == 0.0f) {
+                    for (int k = 0; k < 4; k++) f[87][k] *= VideoCore::g_porte_wide_proj;
+                }
+            }
+            std::memcpy(ptr + used, &data, sizeof(data));
+            (*table)[s] = offset + used;
+            used += uniform_size_aligned_vs_pica;
+        }
+        uniform_buffer.Commit(used);
+    }
+    scheduler.Record([cap, table](vk::CommandBuffer cmdbuf) {
+        g_porte_exec_table = table->data();
+        for (const auto& command : cap->cmds) {
+            command(cmdbuf);
+        }
+        g_porte_exec_table = nullptr;
+    });
+    // what the recorded commands use is in use again now: not reused before the GPU passes this tick
+    StreamBuffer* const rings[4] = {&stream_buffer, &uniform_buffer, &texture_buffer, &texture_lf_buffer};
+    for (std::size_t i = 0; i < 4; i++) {
+        rings[i]->PorteTouch(porte_lo[i], porte_hi[i]);
+    }
+    for (const auto& [pool, index] : cap->sets) {
+        pool->PorteTouch(index);
+    }
+    // surfaces sentenced since the recording began (temporary ones, replaced effect textures) stay alive
+    res_cache.PortePinSince(porte_cap_tick, scheduler.CurrentTick() + 1);
+    scheduler.MakeDirty(StateFlags::Pipeline | StateFlags::DescriptorSets);
+    return true;
+}
+
+// (called from the Ultra Moon frontend without its headers)
+void PorteSetDrawIdx(int index) {
+    g_porte_draw_idx = index;
+}
+void PorteCaptureBegin(VideoCore::RasterizerInterface* r) {
+    if (auto* v = dynamic_cast<RasterizerVulkan*>(r)) {
+        v->PorteCaptureBegin();
+    }
+}
+bool PorteCaptureEnd(VideoCore::RasterizerInterface* r) {
+    auto* v = dynamic_cast<RasterizerVulkan*>(r);
+    return v && v->PorteCaptureEnd();
+}
+bool PorteRepeat(VideoCore::RasterizerInterface* r, const Pica::Uniforms* const* per_draw, std::size_t count) {
+    auto* v = dynamic_cast<RasterizerVulkan*>(r);
+    return v && v->PorteRepeat(per_draw, count);
+}
+
 } // namespace Vulkan
